<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Show our star filter in the layered navigation of category and search result pages -->
    <type name="Magento\Catalog\Model\Layer\FilterList">
        <plugin name="kunal_rating_filter_add_filter" type="Kunal\RatingFilter\Plugin\Layer\AddRatingFilter"/>
    </type>

    <!-- Update the attribute whenever a review is added, approved, edited or deleted -->
    <type name="Magento\Review\Model\ResourceModel\Review">
        <plugin name="kunal_rating_filter_sync" type="Kunal\RatingFilter\Plugin\Review\SyncRatingFilterOnAggregate"/>
    </type>

    <type name="Magento\Framework\Console\CommandListInterface">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="kunal_rating_filter_sync" xsi:type="object">
                    Kunal\RatingFilter\Console\Command\SyncCommand
                </item>
            </argument>
        </arguments>
    </type>
</config>
