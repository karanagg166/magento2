<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="employee_table"
           resource="default"
           engine="innodb"
           comment="Employee Table">

        <!-- Auto Increment Primary Key -->
        <column xsi:type="int"
                name="id"
                identity="true"
                nullable="false"
                unsigned="true"
                comment="ID"/>

        <!-- Employee Code -->
        <column xsi:type="varchar"
                name="employee_id"
                nullable="false"
                length="20"
                comment="Employee ID"/>

        <!-- First Name -->
        <column xsi:type="varchar"
                name="first_name"
                nullable="false"
                length="30"
                comment="First Name"/>

        <!-- Last Name -->
        <column xsi:type="varchar"
                name="last_name"
                nullable="false"
                length="30"
                comment="Last Name"/>

        <!-- Email -->
        <column xsi:type="varchar"
                name="email_id"
                nullable="false"
                length="255"
                comment="Email"/>

        <!-- Address -->
        <column xsi:type="varchar"
                name="address"
                nullable="false"
                length="255"
                comment="Address"/>

        <!-- Phone -->
        <column xsi:type="varchar"
                name="phone_number"
                nullable="false"
                length="10"
                comment="Phone Number"/>

        <!-- Primary Key -->
        <constraint xsi:type="primary"
                    referenceId="PRIMARY">
            <column name="id"/>
        </constraint>

        <!-- Unique Employee ID -->
        <constraint xsi:type="unique"
                    referenceId="EMPLOYEE_TABLE_EMPLOYEE_ID_UNIQUE">
            <column name="employee_id"/>
        </constraint>

        <!-- Unique Email -->
        <constraint xsi:type="unique"
                    referenceId="EMPLOYEE_TABLE_EMAIL_UNIQUE">
            <column name="email_id"/>
        </constraint>

    </table>

</schema>