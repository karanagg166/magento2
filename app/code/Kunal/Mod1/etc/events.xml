<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">

    <!-- Trigger: fires after OrderManagement::place() saved the order, for both
         frontend checkout and admin-created orders. -->
    <event name="sales_model_service_quote_submit_success">
        <observer name="kunal_mod1_custom_order_placement_trigger"
                  instance="Kunal\Mod1\Observer\OrderPlacementTriggerObserver"/>
    </event>

    <!-- Custom event: dispatched by the trigger above only for designated
         customer groups, handled here by persisting the group's sales total. -->
    <event name="custom_order_placement">
        <observer name="kunal_mod1_store_customer_group_sales"
                  instance="Kunal\Mod1\Observer\CustomerGroupSalesObserver"/>
    </event>

</config>
