<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Preference -->
    <preference for="Kunal\Mod1\Api\Data\CategoryInterface"
                type="Kunal\Mod1\Model\Category"/>
    
    <type name="Kunal\Mod1\Test">
        <arguments>

            <argument name="params" xsi:type="array">
                <item name="color" xsi:type="string">Blue</item>
                <item name="size" xsi:type="string">XL</item>
                <item name="brand" xsi:type="string">Nike</item>
            </argument>

            <argument name="message" xsi:type="string">
                Hello from Dependency Injection!
            </argument>

        </arguments>
    </type>
    <type name="Kunal\Mod1\Logger\Logger">
    <arguments>
        <argument name="name" xsi:type="string">mod1</argument>

        <argument name="handlers" xsi:type="array">
            <item name="system" xsi:type="object">
                Kunal\Mod1\Logger\Handler
            </item>
        </argument>
    </arguments>
</type>

<type name="Magento\Catalog\Model\Product">
        <plugin
            name="product_sale_plugin"
            type="Kunal\Mod1\Plugin\ProductPlugin"/>
        <plugin 
            name="product_price_plugin"
            type="Kunal\Mod1\Plugin\ProductPricePlugin"/>
    </type>

    <type name="Magento\Theme\Block\Html\Header">
        <plugin
            name="header_plugin"
            type="Kunal\Mod1\Plugin\HeaderPlugin"/>
    </type>

    <type name="Magento\Theme\Block\Html\Footer">
        <plugin
            name="footer_plugin"
            type="Kunal\Mod1\Plugin\FooterPlugin"/>
    </type>

    <type name="Magento\Theme\Block\Html\Breadcrumbs">
        <plugin
            name="breadcrumb_plugin"
            type="Kunal\Mod1\Plugin\BreadcrumbsPlugin"/>
    </type>

</config>
