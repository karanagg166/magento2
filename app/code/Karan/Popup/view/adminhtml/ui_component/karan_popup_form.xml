<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">karan_popup_form.karan_popup_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Popup Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="save" class="Karan\Popup\Block\Adminhtml\Popup\Edit\SaveButton"/>
            <button name="back" class="Karan\Popup\Block\Adminhtml\Popup\Edit\BackButton"/>
        </buttons>
        <namespace>karan_popup_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>karan_popup_form.karan_popup_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="karan_popup_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="karan_popup/index/save"/>
        </settings>
        <dataProvider class="Karan\Popup\Model\Popup\DataProvider" name="karan_popup_form_data_source">
            <settings>
                <requestFieldName>popup_id</requestFieldName>
                <primaryFieldName>popup_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <label/>
        </settings>
        <field name="popup_id" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">popup</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <visible>false</visible>
                <dataScope>popup_id</dataScope>
            </settings>
        </field>
        <field name="title" sortOrder="10" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">popup</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Popup Title</label>
                <dataScope>title</dataScope>
            </settings>
        </field>
        <field name="is_active" sortOrder="20" formElement="checkboxset">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">popup</item>
                </item>
            </argument>
            <settings>
                <dataType>number</dataType>
                <label translate="true">Status</label>
                <dataScope>is_active</dataScope>
            </settings>
            <formElements>
                <checkboxset>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </checkboxset>
            </formElements>
        </field>
        <field name="content" sortOrder="30" formElement="textarea">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">popup</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>text</dataType>
                <label translate="true">Popup Content</label>
                <dataScope>content</dataScope>
            </settings>
        </field>
    </fieldset>
</form>
