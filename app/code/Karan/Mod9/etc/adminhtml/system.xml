<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <!-- The Mod9 tab that groups the configuration sections -->
        <tab id="mod9" translate="label" sortOrder="400">
            <label>Mod9</label>
        </tab>

        <!-- The "General" section under the Mod9 tab -->
        <section id="mod9_general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>General</label>
            <tab>mod9</tab>
            <resource>Karan_Mod9::config</resource>

            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General</label>

                <field id="enable" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>

                <field id="text_to_display" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Text to Display</label>
                </field>
            </group>
        </section>
        <section id="mod9_mod16" translate="label" type="text" sortOrder="12" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Mod16</label>
            <tab>mod9</tab>
            <resource>Karan_Mod9::config</resource>

            <group id="mod16" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Mod16</label>

                <field id="color"
                    translate="label"
                    type="text"
                    sortOrder="10"
                    showInDefault="1"
                    showInWebsite="1"
                    showInStore="1">
                    <label>Color</label>
                    <frontend_model>Karan\Mod9\Block\Adminhtml\System\Config\Form\Field\ColorPicker</frontend_model>
                </field>

            </group>
        </section>
    </system>
</config>
