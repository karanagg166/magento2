<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="employee_table" resource="default" engine="innodb" comment="Employee Table for Headless API">
        <column xsi:type="int" name="id" unsigned="true" nullable="false" identity="true" comment="ID"/>
        <column xsi:type="varchar" name="employee_id" nullable="true" length="20" comment="Employee ID Code"/>
        <column xsi:type="varchar" name="first_name" nullable="true" length="30" comment="First Name"/>
        <column xsi:type="varchar" name="last_name" nullable="true" length="30" comment="Last Name"/>
        <column xsi:type="varchar" name="name" nullable="true" length="255" comment="Employee Name"/>
        <column xsi:type="varchar" name="email_id" nullable="true" length="255" comment="Email ID"/>
        <column xsi:type="varchar" name="email" nullable="true" length="255" comment="Email"/>
        <column xsi:type="varchar" name="address" nullable="true" length="255" comment="Address"/>
        <column xsi:type="varchar" name="phone_number" nullable="true" length="10" comment="Phone Number"/>
        <column xsi:type="varchar" name="department" nullable="true" length="100" comment="Department"/>
        <column xsi:type="varchar" name="position" nullable="true" length="100" comment="Position"/>
        <column xsi:type="decimal" name="salary" scale="2" precision="12" nullable="true" default="0.00" comment="Salary"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="id"/>
        </constraint>
    </table>
</schema>
