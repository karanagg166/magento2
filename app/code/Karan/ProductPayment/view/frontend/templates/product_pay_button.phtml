<script>
require(['jquery', 'domReady!'], function($) {
    'use strict';

    var PUBLISHABLE_KEY  = '<?= $publishableKey ?>';
    var CREATE_INTENT_URL = '<?= $createIntentUrl ?>';
    var PRODUCT_ID       = <?= $productId ?>;
    var prefill          = <?= $prefill /* already JSON, already escaped */ ?>;

    var stripeJs, cardElement, clientSecret, quoteId;

    // ── Prefill form ──────────────────────────────────────────────────────
    function prefillForm() {
        if (prefill.firstname) $('#kp-firstname').val(prefill.firstname);
        if (prefill.lastname)  $('#kp-lastname').val(prefill.lastname);
        if (prefill.email)     $('#kp-email').val(prefill.email);
        if (prefill.telephone) $('#kp-telephone').val(prefill.telephone);
        if (prefill.street)    $('#kp-street').val(prefill.street);
        if (prefill.city)      $('#kp-city').val(prefill.city);
        if (prefill.region)    $('#kp-region').val(prefill.region);
        if (prefill.postcode)  $('#kp-postcode').val(prefill.postcode);
        if (prefill.country)   $('#kp-country').val(prefill.country);
    }

    // ── Load Stripe.js dynamically ────────────────────────────────────────
    function loadStripeJs(callback) {
        if (window.Stripe) { callback(); return; }
        var s = document.createElement('script');
        s.src = 'https://js.stripe.com/v3/';
        s.onload = callback;
        document.head.appendChild(s);
    }

    // ── Mount Stripe Card Element ─────────────────────────────────────────
    function mountCardElement() {
        stripeJs = window.Stripe(PUBLISHABLE_KEY);
        var elements = stripeJs.elements();
        cardElement = elements.create('card', {
            style: {
                base: {
                    fontSize: '15px',
                    color: '#111',
                    fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
                    '::placeholder': { color: '#9ca3af' }
                },
                invalid: { color: '#dc2626' }
            }
        });
        cardElement.mount('#karan-stripe-element');
        cardElement.on('change', function(e) {
            showError(e.error ? e.error.message : '');
        });
        $('#karan-pay-submit').prop('disabled', false).find('#kp-submit-text').text('Pay Now');
    }

    // ── Open / Close modal ────────────────────────────────────────────────
    $('#karan-pay-now-btn').on('click', function() {
        prefillForm();
        $('#karan-pay-overlay').addClass('open');
        $('body').css('overflow', 'hidden');

        if (!stripeJs) {
            loadStripeJs(mountCardElement);
        }
    });

    function closeModal() {
        $('#karan-pay-overlay').removeClass('open');
        $('body').css('overflow', '');
    }

    $('#karan-pay-close, #karan-pay-overlay').on('click', function(e) {
        if (e.target === this) closeModal();
    });
    $(document).on('keydown', function(e) {
        if (e.key === 'Escape') closeModal();
    });

    // ── Helpers ───────────────────────────────────────────────────────────
    function showError(msg) {
        var $err = $('#karan-pay-error');
        if (msg) { $err.text(msg).show(); } else { $err.hide().text(''); }
    }

    function setLoading(loading) {
        var $btn = $('#karan-pay-submit');
        $btn.prop('disabled', loading);
        $('#kp-submit-text').text(loading ? 'Processing…' : 'Pay Now');
    }

    function getQty() {
        var v = parseInt($('#qty').val(), 10);
        return isNaN(v) || v < 1 ? 1 : v;
    }

    // ── Step 1: Create PaymentIntent (server side) ────────────────────────
    function createIntent(shippingData, callback) {
        $.ajax({
            url: CREATE_INTENT_URL,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                product_id: PRODUCT_ID,
                qty: getQty(),
                shipping: shippingData
            }),
            success: function(resp) {
                if (resp.success) {
                    callback(null, resp);
                } else {
                    callback(resp.error || 'Could not initialize payment.');
                }
            },
            error: function(xhr) {
                callback('Server error. Please try again.');
            }
        });
    }

    // ── Step 2: Confirm payment with Stripe.js ────────────────────────────
    function confirmPayment(secret, billingDetails, callback) {
        stripeJs.confirmCardPayment(secret, {
            payment_method: {
                card: cardElement,
                billing_details: billingDetails
            }
        }).then(function(result) {
            if (result.error) {
                callback(result.error.message);
            } else {
                callback(null, result.paymentIntent);
            }
        });
    }

    // ── Step 3: Confirm order on server ──────────────────────────────────
    function confirmOrder(intentId, qId, callback) {
        $.ajax({
            url: CREATE_INTENT_URL.replace('createIntent', 'confirm'),
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                payment_intent_id: intentId,
                quote_id: qId
            }),
            success: function(resp) {
                if (resp.success) {
                    callback(null, resp);
                } else {
                    callback(resp.error || 'Order placement failed.');
                }
            },
            error: function() {
                callback('Server error while placing order.');
            }
        });
    }

    // ── Main submit handler ───────────────────────────────────────────────
    $('#karan-pay-submit').on('click', function() {
        showError('');

        var shippingData = {
            firstname : $('#kp-firstname').val().trim(),
            lastname  : $('#kp-lastname').val().trim(),
            email     : $('#kp-email').val().trim(),
            telephone : $('#kp-telephone').val().trim(),
            street    : $('#kp-street').val().trim(),
            city      : $('#kp-city').val().trim(),
            region    : $('#kp-region').val().trim(),
            postcode  : $('#kp-postcode').val().trim(),
            country   : $('#kp-country').val()
        };

        // Basic front-end validation
        if (!shippingData.firstname || !shippingData.lastname || !shippingData.email
            || !shippingData.street || !shippingData.city || !shippingData.postcode) {
            showError('Please fill in all required shipping fields.');
            return;
        }

        setLoading(true);

        // ── Step 1 ──
        createIntent(shippingData, function(err, data) {
            if (err) { showError(err); setLoading(false); return; }

            clientSecret = data.client_secret;
            quoteId      = data.quote_id;

            // Update summary price
            if (data.currency && data.amount) {
                $('#kp-amount-label').text(data.currency + ' ' + parseFloat(data.amount).toFixed(2));
            }

            var billingDetails = {
                name  : shippingData.firstname + ' ' + shippingData.lastname,
                email : shippingData.email,
                phone : shippingData.telephone,
                address: {
                    line1       : shippingData.street,
                    city        : shippingData.city,
                    state       : shippingData.region,
                    postal_code : shippingData.postcode,
                    country     : shippingData.country
                }
            };

            // ── Step 2 ──
            confirmPayment(clientSecret, billingDetails, function(err2, intent) {
                if (err2) { showError(err2); setLoading(false); return; }

                // ── Step 3 ──
                confirmOrder(intent.id, quoteId, function(err3, result) {
                    setLoading(false);
                    if (err3) { showError(err3); return; }

                    closeModal();
                    window.location.href = window.BASE_URL + result.redirect_url;
                });
            });
        });
    });
});
</script>
