<?xml version="1.0"?>

<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="karan_category_permission"
           resource="default"
           engine="innodb"
           comment="Category Permission Rules">

        <column xsi:type="int"
                name="permission_id"
                unsigned="true"
                nullable="false"
                identity="true"
                comment="Permission ID"/>

        <column xsi:type="int"
                name="category_id"
                unsigned="true"
                nullable="false"
                comment="Category ID"/>

        <column xsi:type="smallint"
                name="website_id"
                unsigned="true"
                nullable="false"
                comment="Website ID"/>

        <column xsi:type="int"
                name="customer_group_id"
                unsigned="true"
                nullable="false"
                comment="Customer Group ID"/>

        <column xsi:type="smallint"
                name="can_browse"
                unsigned="true"
                nullable="false"
                default="1"
                comment="Can Browse Category"/>

        <column xsi:type="smallint"
                name="can_view_price"
                unsigned="true"
                nullable="false"
                default="1"
                comment="Can View Price"/>

        <column xsi:type="smallint"
                name="can_add_to_cart"
                unsigned="true"
                nullable="false"
                default="1"
                comment="Can Add To Cart"/>

        <column xsi:type="timestamp"
                name="created_at"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                on_update="false"
                comment="Created At"/>

        <column xsi:type="timestamp"
                name="updated_at"
                nullable="false"
                default="CURRENT_TIMESTAMP"
                on_update="true"
                comment="Updated At"/>

        <constraint xsi:type="primary"
                    referenceId="PRIMARY">
            <column name="permission_id"/>
        </constraint>

        <constraint xsi:type="foreign"
                    referenceId="KARAN_CATEGORY_PERMISSION_CATEGORY_ID_CATALOG_CATEGORY_ENTITY_ENTITY_ID"
                    table="karan_category_permission"
                    column="category_id"
                    referenceTable="catalog_category_entity"
                    referenceColumn="entity_id"
                    onDelete="CASCADE"/>

        <constraint xsi:type="foreign"
                    referenceId="KARAN_CATEGORY_PERMISSION_WEBSITE_ID_STORE_WEBSITE_WEBSITE_ID"
                    table="karan_category_permission"
                    column="website_id"
                    referenceTable="store_website"
                    referenceColumn="website_id"
                    onDelete="CASCADE"/>

        <constraint xsi:type="foreign"
                    referenceId="KARAN_CATEGORY_PERMISSION_CUSTOMER_GROUP_ID_CUSTOMER_GROUP_CUSTOMER_GROUP_ID"
                    table="karan_category_permission"
                    column="customer_group_id"
                    referenceTable="customer_group"
                    referenceColumn="customer_group_id"
                    onDelete="CASCADE"/>

        <constraint xsi:type="unique"
                    referenceId="KARAN_CATEGORY_PERMISSION_CATEGORY_WEBSITE_GROUP_UNIQUE">
            <column name="category_id"/>
            <column name="website_id"/>
            <column name="customer_group_id"/>
        </constraint>

        <index referenceId="KARAN_CATEGORY_PERMISSION_CATEGORY_ID"
               indexType="btree">
            <column name="category_id"/>
        </index>

        <index referenceId="KARAN_CATEGORY_PERMISSION_WEBSITE_ID"
               indexType="btree">
            <column name="website_id"/>
        </index>

        <index referenceId="KARAN_CATEGORY_PERMISSION_CUSTOMER_GROUP_ID"
               indexType="btree">
            <column name="customer_group_id"/>
        </index>

    </table>

</schema>