<?xml version="1.0"?>
<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="connect-src">
            <values>
                <value id="smartystreets" type="host">*.smartystreets.com</value>
                <value id="smartystreets_api" type="host">us-autocomplete.api.smartystreets.com</value>
                <value id="smartystreets_street_api" type="host">us-street.api.smartystreets.com</value>
            </values>
        </policy>
        <policy id="script-src">
            <values>
                <value id="smartystreets" type="host">*.smartystreets.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
